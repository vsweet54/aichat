# Wajib: API key Zapi (jangan di-commit, isi di Vercel > Settings > Environment Variables)
# Bisa banyak key, pisahkan dengan koma. Satu key juga boleh.
ZAPI_API_KEYS=key_satu,key_dua,key_tiga

# Disarankan: token rahasia, harus sama dengan yang dikirim APK lewat header x-app-token
APP_TOKEN=isi_token_acak_panjang

# Opsional
ZAPI_BASE_URL=https://api.zapi.ink
PER_MODEL_TIMEOUT_MS=9000
TOTAL_BUDGET_MS=55000
