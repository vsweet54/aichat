# ==============================================================
# NEOAI Backend Environment Variables (.env)
# ==============================================================
# Server Port (untuk pengujian lokal)
PORT=3000

# Kunci API Provider (Minimal 1 kunci untuk mengaktifkan model berbayar)
# Jika semua kosong, sistem otomatis menggunakan Pollinations AI (Gratis 100% tanpa kunci!)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Rahasia aplikasi opsional untuk proteksi endpoint (jika diinginkan)
APP_SECRET=
