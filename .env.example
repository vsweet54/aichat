# OpenRouter API Key (Required for AI generation)
# Obtain your free API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter Base URL (Default: https://openrouter.ai/api/v1)
OPENROUTER_URL=https://openrouter.ai/api/v1

# Shared secret between Android APK and Backend (Optional but recommended for production)
# If set, Android app must pass this in 'x-app-secret' header
APP_SECRET=neo_secret_2026_secure_key

# Admin Token for privileged actions like forcing cache refresh on /api/models
ADMIN_TOKEN=neo_admin_super_secret_token

# Local port (Default: 3000)
PORT=3000
